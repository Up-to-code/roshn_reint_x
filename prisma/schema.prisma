// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map(name: "created_at")
  updatedAt         DateTime @default(now()) @map(name: "updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map(name: "accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map(name: "sessions")
}

// prisma/schema.prisma
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Add this field
  role          UserRole  @default(USER)
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map(name: "verification_tokens")
}

model Property {
  id            String   @id @default(cuid())
  // Language-specific fields
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  // Basic property fields
  city          String
  district      String?
  images        String[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("properties")
}

model Post {
  id          String   @id @default(cuid())
  title       String
  content     String
  excerpt     String?
  headerImage String?
  thumbnail   String?
  status      PostStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("posts")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}


model Contact {
  id          String   @id @default(cuid())
  name        String
  phoneNumber String
  message     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contacts")
}

// Single-row JSON-backed site settings
model SiteSettings {
  id        String   @id // use a stable id like "default"
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// About page content stored as JSON
model AboutPage {
  id        String   @id // use a stable id like "default"
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("about_page")
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String
  features    String[] // Array of features
  order       Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model ServicesPage {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  heroImage String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services_page")
}

// About settings content stored as JSON
model AboutSettings {
  id        String   @id // use a stable id like "default"
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("about_settings")
}

model Interest {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String
  message     String?
  propertyTitle String
  createdAt   DateTime @default(now())
}
